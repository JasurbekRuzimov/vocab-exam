# /etc/systemd/system/examaker.service
# Server qayta yoqilganda ilova o'zi ishga tushadi, yiqilsa qayta ko'tariladi.
[Unit]
Description=Examaker (Spring Boot)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=examaker
Group=examaker
WorkingDirectory=/opt/examaker
EnvironmentFile=/etc/examaker/examaker.env
ExecStart=/bin/sh -c 'exec /usr/bin/java $JAVA_OPTS -jar /opt/examaker/examaker.jar'
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/examaker /var/log/examaker

[Install]
WantedBy=multi-user.target
