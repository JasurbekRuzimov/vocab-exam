# /etc/systemd/system/vocabexam.service
# Server qayta yoqilganda ilova o'zi ishga tushadi, yiqilsa qayta ko'tariladi.
[Unit]
Description=VocabExam (Spring Boot)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=vocabexam
Group=vocabexam
WorkingDirectory=/opt/vocabexam
EnvironmentFile=/etc/vocabexam/vocabexam.env
ExecStart=/bin/sh -c 'exec /usr/bin/java $JAVA_OPTS -jar /opt/vocabexam/vocabexam.jar'
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/vocabexam /var/log/vocabexam

[Install]
WantedBy=multi-user.target
